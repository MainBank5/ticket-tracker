{
  "name": "ticket-tracker-api",
  "version": "1.0.0",
  "description": "Mini Ticket Tracker REST API",
  "scripts": {
    "test": "NODE_ENV=test node --import tsx --test --test-concurrency=1 --test-reporter=spec \"tests/**/*.test.ts\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "pretest": "NODE_ENV=test prisma migrate deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "prisma": "7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.19"
  }
}
